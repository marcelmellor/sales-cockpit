# HubSpot authentication
# The app uses a HubSpot Private App Token issued from the sipgate 2025
# HubSpot (Account ID 27058496). Only admins in that hub can create one —
# see AGENTS.md → "HubSpot authentication" for the exact procedure and
# which scopes the token needs.
# Format: pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_PRIVATE_APP_TOKEN="pat-eu1-your-private-app-token"

# NextAuth v5 (Google sign-in for the cockpit's own users)
# AUTH_URL should be your app's public URL (e.g., https://yourdomain.com in production)
AUTH_URL="https://cockpit.localhost"

# Local-dev only: bypass Google OAuth so you don't need a redirect-URI configured
# for *.localhost in Google Cloud Console (Google rejects non-public TLDs).
# Production/Netlify must NOT set this — leave it unset or false.
NEXT_PUBLIC_AUTH_DISABLED=true
# Generate a secret with: openssl rand -base64 32
# NextAuth v5 uses AUTH_SECRET (NEXTAUTH_SECRET is legacy but also supported)
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"

# Google OAuth for sign-in (configured in Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Shared secret for the read-only /tv view AND the MCP server's internal
# self-calls to the overview endpoints. Generate with: openssl rand -hex 32
TV_SECRET="your-tv-secret-generate-with-openssl-rand-hex-32"

# MCP server (GET/POST /api/mcp). Bearer token clients must send as
# `Authorization: Bearer <MCP_SECRET>`. Required — the endpoint returns 503
# until it is set. Generate with: openssl rand -hex 32
MCP_SECRET="your-mcp-secret-generate-with-openssl-rand-hex-32"
